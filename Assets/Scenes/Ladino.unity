--- !u!114 &243363182
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 243363179}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23573cce63f52a049a8f136c01f63404, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  texto: {fileID: 1171682797}
  mensagemCompleta: "Tu \xE9s Anduino, paladino da sagrada luz, escolhido pelos des\xEDgnios
    celestiais. \nDiante de ti se ergue um fardo glorioso: encontrar o Crep\xFAsculo
    Perdido, artefato ancestral capaz de comandar o nascer e o p\xF4r do sol. Oculto
    nas ru\xEDnas de um reino esquecido, seu poder \xE9 cobi\xE7ado pela vil Ordem
    das Sombras, que deseja lan\xE7ar o mundo em trevas eternas. \nErgue tua l\xE2mina,
    fortalece teu esp\xEDrito, pois sobre teus ombros recai o destino da luz."
  velocidadeDigitacao: 0.08
  narrativa: {fileID: 8300000, guid: 2d63531d07c2da640b4d304c2276c81f, type: 3}
