  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ap\xF3s uma batalha \xE1rdua contra O Corruptor do Crep\xFAsculo, o paladino
    Anduino ergue sua espada banhada pela luz sagrada e desfere o golpe final, dissipando
    a corrup\xE7\xE3o que amea\xE7ava engolir o mundo. No momento da vit\xF3ria,
    o Artefato do Crep\xFAsculo resplandece em suas m\xE3os, e Anduino decide entreg\xE1-lo
    \xE0 Ordem Sagrada da Luz, onde ficar\xE1 guardado sob prote\xE7\xE3o eterna."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
